# Copy this file to .env and change local credentials before enabling monitoring.

# Kafka topics can be expanded but cannot be shrunk after creation.
KAFKA_TOPIC_PARTITIONS=8

# Capture profile. PCAPs are intentionally not committed.
PCAP_FILENAME=capture.pcap
CAPTURE_MODE=pcap-freno
PCAP_FRENO_MAX_LEAD_SECONDS=0.25
CAPTURE_INTERFACE=
MONITORED_DEVICE=unknown
NFSTREAM_METERS=6
AI_INFERENCE_REPLICAS=8
AI_DETECTOR_REPLICAS=4
INFERENCE_BATCH_SIZE=900
INFERENCE_IDLE_POLL_SECONDS=0.001
NFSTREAM_REQUIRE_EXACT_METERS=true
# On Linux, set these to the owner of the checkout (`id -u` / `id -g`) so the
# non-root detector and telemetry processes can write their bind-mounted CSVs.
TC35_OUTPUT_UID=1000
TC35_OUTPUT_GID=1000
KAFKA_MAX_PENDING_SENDS=1000
KAFKA_BATCH_SIZE=32768
KAFKA_LINGER_MS=10
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_FLUSH_PACKET_INTERVAL=900
KAFKA_CLEANUP_FLUSH_FLOW_INTERVAL=300
KAFKA_ACKS=1
KAFKA_RETRIES=0

# Local observability profile.
MAX_POLL_RECORDS=500
MONITORING_WINDOW_SECONDS=5
ALLOWED_LATENESS_SECONDS=5
IDLE_FLUSH_SECONDS=1
REBASE_EVENT_TIME=true
MONITORED_LABELS=normal_traffic,benign_heavy_hitter,malign_heavy_hitter
BENIGN_HH_LABELS=benign_heavy_hitter
MALIGN_LABELS=malign_heavy_hitter
INFLUX_USERNAME=tc35
INFLUX_PASSWORD=change-this-local-password
INFLUX_ORG=tc35
INFLUX_TOKEN=change-this-local-influx-token-0123456789
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-grafana-password
